# Three variables are the only difference between a model on this laptop and one in a
# datacentre. Nothing else in the code changes when you swap them.

# Ollama, running locally (no account, no card, no quota)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama            # Ollama ignores this, but the OpenAI client requires one
LLM_MODEL=gemma3:4b

# OpenRouter instead, if you prefer a hosted model
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-key-here
# LLM_MODEL=openrouter/free

# Set to 1 to answer from a fixed stub and never call a model
LLM_STUB=0
# Set to false to disable the model entirely and return the deterministic fallback
LLM_ENABLED=true

# Lower this only to test the timeout path. 30 is the real value.
LLM_TIMEOUT_SECONDS=30
