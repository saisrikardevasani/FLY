# The LLM that answers each decision node with YES or NO.
# Defaults point at a local Ollama, which needs no account, key or card.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama          # Ollama ignores this, the OpenAI SDK requires a value
LLM_MODEL=gemma3:4b

# Swap those three for a hosted provider and nothing else changes:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Tells the Inngest SDK to talk to the local Dev Server rather than Inngest Cloud.
INNGEST_DEV=1
