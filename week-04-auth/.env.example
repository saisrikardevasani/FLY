# Supabase Dashboard -> Project Settings -> API
# Use the anon (public) key. Never the service_role key: it bypasses every rule.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_key
PORT=8000

# Comma separated. Anyone not on this list gets 403 from /protected/admin.
ADMIN_EMAILS=admin@example.com
